# Coordinates of your home — find them at https://www.latlong.net/
LATITUDE=48.856613
LONGITUDE=2.352222

# Language of the notification message: "fr" or "en"
LANGUAGE=fr

TELEGRAM_BOT_TOKEN=CHANGE-ME:your-bot-token
TELEGRAM_CHAT_ID=CHANGE-ME

NTFY_TOPIC=tempo-certo-CHANGE-ME

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=app-password
SMTP_FROM=your.address@gmail.com
SMTP_TO=your.address@gmail.com

# Email alert sent automatically whenever the script errors out
# (network failure, unexpected exception, etc.), regardless of NOTIFY_METHOD
ERROR_ALERT_EMAIL_ENABLED=true
ERROR_ALERT_EMAIL_TO=your.address@gmail.com
